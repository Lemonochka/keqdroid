+			inet4 = true
+		} else {
+			inet6 = true
+		}
+	}
+
+	var addresses []netip.Prefix
+	for _, address := range t.options.Gateway {
+		if prefix, err := netip.ParsePrefix(address); err == nil {
+			addresses = append(addresses, prefix)
+		}
+	}
+	// as sing-tun: the tun itself checks loosely, whatever net.ipv4.conf.all says
+	_ = os.WriteFile("/proc/sys/net/ipv4/conf/"+attrs.Name+"/rp_filter", []byte("2"), 0o644)
+
+	if err := deleteSystemRules(); err != nil {
+		_ = t.unsetSystemRoutes()
