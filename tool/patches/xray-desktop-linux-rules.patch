index 0000000..1fb584c
--- /dev/null
+++ b/proxy/tun/tun_linux_rules_test.go
@@ -0,0 +1,115 @@
+//go:build linux && !android
+
+package tun
+
+import (
+	"fmt"
+	"net/netip"
+	"strings"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func describeRules(t *testing.T, inet4, inet6 bool) []string {
+	t.Helper()
+	addresses := []netip.Prefix{
+		netip.MustParsePrefix("172.19.0.1/30"),
+		netip.MustParsePrefix("fdfe:dcba:9876::1/126"),
+	}
+	var out []string
+	for _, r := range buildSystemRules("tun-keqdis", addresses, inet4, inet6) {
+		family := "v4"
+		if r.Family == unix.AF_INET6 {
+			family = "v6"
+		}
+		var parts []string
+		if r.Invert {
+			parts = append(parts, "not")
+		}
+		if r.Src != nil {
+			parts = append(parts, "from "+r.Src.String())
+		}
+		if r.Dst != nil {
+			parts = append(parts, "to "+r.Dst.String())
+		}
+		if r.IifName != "" {
+			parts = append(parts, "iif "+r.IifName)
+		}
+		if r.Dport != nil {
+			parts = append(parts, fmt.Sprintf("dport %d", r.Dport.Start))
+		}
+		if r.UIDRange != nil {
+			parts = append(parts, fmt.Sprintf("uidrange %d-%d", r.UIDRange.Start, r.UIDRange.End))
+		}
+		switch {
+		case r.Type == unix.FR_ACT_NOP:
+			parts = append(parts, "nop")
+		case r.Goto >= 0:
+			parts = append(parts, fmt.Sprintf("goto %d", r.Goto))
+		case r.Table == unix.RT_TABLE_MAIN:
+			parts = append(parts, fmt.Sprintf("lookup main suppress %d", r.SuppressPrefixlen))
+		default:
+			parts = append(parts, fmt.Sprintf("lookup %d", r.Table))
+		}
+		out = append(out, fmt.Sprintf("%s %d: %s", family, r.Priority, strings.Join(parts, " ")))
+	}
+	return out
+}
+
+func TestSystemRulesMatchSingTunLayout(t *testing.T) {
+	got := describeRules(t, true, true)
+	want := []string{
+		"v4 9100: to 172.19.0.0/30 lookup 2026",
+		"v4 9101: not dport 53 lookup main suppress 0",
+		"v4 9101: iif tun-keqdis goto 9110",
+		"v4 9102: not iif lo lookup 2026",
+		"v4 9102: from 0.0.0.0/32 iif lo lookup 2026",
+		"v4 9102: from 172.19.0.0/30 iif lo lookup 2026",
+		"v4 9102: iif lo uidrange 1-4294967294 lookup 2026",
+		"v4 9110: nop",
+		"v6 9100: not dport 53 lookup main suppress 0",
+		"v6 9101: from fdfe:dcba:9876::/126 iif lo lookup 2026",
+		"v6 9102: iif tun-keqdis goto 9110",
+		"v6 9102: iif lo uidrange 1-4294967294 lookup 2026",
+		"v6 9102: from ::/1 iif lo goto 9110",
+		"v6 9102: from 8000::/1 iif lo goto 9110",
+		"v6 9103: lookup 2026",
+		"v6 9110: nop",
+	}
+	if strings.Join(got, "\n") != strings.Join(want, "\n") {
+		t.Fatalf("rules:\n%s\nwant:\n%s", strings.Join(got, "\n"), strings.Join(want, "\n"))
+	}
+}
+
+func TestSystemRulesOnlyForCapturedFamilies(t *testing.T) {
+	for _, line := range describeRules(t, true, false) {
+		if strings.HasPrefix(line, "v6") {
+			t.Fatalf("IPv6 rule without an IPv6 route: %s", line)
+		}
+	}
+	if got := describeRules(t, false, false); len(got) != 0 {
+		t.Fatalf("rules without routes: %v", got)
+	}
+}
+
+// the reverse path check looks up as root: a rule for root's sockets would send
+// it to the TUN and bring back the rp_filter=1 failure this layout fixes
+func TestSystemRulesLeaveRootToMain(t *testing.T) {
+	for _, r := range buildSystemRules("tun-keqdis", nil, true, true) {
+		if r.UIDRange != nil && r.UIDRange.Start == 0 {
+			t.Fatalf("rule %d covers uid 0", r.Priority)
+		}
+	}
+}
+
+func TestSystemRulesStayInsideTheirRange(t *testing.T) {
+	for _, r := range buildSystemRules("tun-keqdis", nil, true, true) {
+		if r.Priority < systemRuleStart || r.Priority > systemRuleNop {
+			t.Fatalf("priority %d is outside %d..%d, deleteSystemRules would leave it behind", r.Priority, systemRuleStart, systemRuleNop)
+		}
+		if r.Goto >= 0 && r.Goto <= r.Priority {
+			t.Fatalf("goto %d from %d: the kernel only jumps forward", r.Goto, r.Priority)
+		}
+	}
+}
