+// The system routes live in their own table behind policy rules, the layout
+// sing-tun uses for auto_route (tun_linux.go rules(), non-mark mode), instead of
+// the main table. A route in main also answers the reverse path check: with
+// rp_filter=1 a reply from the server arriving on the physical interface had
+// its source routed back through the TUN and was dropped, so nothing worked.
+// Policy rules leave that check to main, because it looks up as root with iif
+// lo and the packet's local address as source, which no rule here takes to the
+// TUN.
+const (
+	systemRouteTable = 2026
+	systemRuleStart  = 9100
+	systemRuleNop    = systemRuleStart + 10
+)
+
+func prefixIPNet(prefix netip.Prefix) *net.IPNet {
+	return &net.IPNet{
+		IP:   prefix.Addr().AsSlice(),
+		Mask: net.CIDRMask(prefix.Bits(), prefix.Addr().BitLen()),
+	}
+}
+
+// userUIDs is every uid but root. A socket bound to the address of the
+// physical interface carries its source into the lookup and would pass every
+// source rule to main: a browser's WebRTC binds such a socket for each network
+// and its STUN request showed the real address. The reverse path check looks
+// up as uid 0 (sock_net_uid with no socket), so this rule leaves it alone.
+func userUIDs() *netlink.RuleUIDRange {
+	return netlink.NewRuleUIDRange(1, 0xfffffffe)
+}
+
+// replyMark takes a reply of a connection that came from outside past the
+// TUN: Sunshine answering a viewer, a game server or a seeding torrent run by
+// the user. The userUIDs rule alone sends those replies into the TUN, since a
+// policy rule cannot tell a reply from a new connection made from a bound
+// socket. Conntrack can: an nftables route chain marks every packet that goes
+// out in the reply direction and the kernel looks its route up again, the way
+// sing-tun's auto_redirect leaves replies alone (output_prematch, ct direction
+// reply). A packet that already has a mark is not touched.
+const (
+	replyMark      = 0x2026
+	replyMarkTable = "keqdroid_xray"
+)
+
+func replyMarkExprs() []expr.Any {
+	return []expr.Any{
+		&expr.Ct{Key: expr.CtKeyDIRECTION, Register: 1},
+		&expr.Cmp{Op: expr.CmpOpEq, Register: 1, Data: []byte{1}}, // IP_CT_DIR_REPLY
+		&expr.Meta{Key: expr.MetaKeyMARK, Register: 1},
+		&expr.Cmp{Op: expr.CmpOpEq, Register: 1, Data: binaryutil.NativeEndian.PutUint32(0)},
+		&expr.Immediate{Register: 1, Data: binaryutil.NativeEndian.PutUint32(replyMark)},
+		&expr.Meta{Key: expr.MetaKeyMARK, Register: 1, SourceRegister: true},
+	}
+}
+
+// setReplyMark replaces a table a crashed run left. A table left behind only
+// marks replies: without the fwmark rule the mark leads nowhere.
+func setReplyMark() error {
+	if err := deleteReplyMark(); err != nil {
+		return err
+	}
+	nft, err := nftables.New()
+	if err != nil {
+		return errors.New("failed to open nftables").Base(err)
+	}
+	table := nft.AddTable(&nftables.Table{Name: replyMarkTable, Family: nftables.TableFamilyINet})
+	chain := nft.AddChain(&nftables.Chain{
+		Name:     "output",
+		Table:    table,
+		Hooknum:  nftables.ChainHookOutput,
+		Priority: nftables.ChainPriorityMangle,
+		Type:     nftables.ChainTypeRoute,
+	})
+	nft.AddRule(&nftables.Rule{Table: table, Chain: chain, Exprs: replyMarkExprs()})
+	if err := nft.Flush(); err != nil {
+		return errors.New("failed to add nftables table ", replyMarkTable).Base(err)
+	}
+	return nil
+}
+
+func deleteReplyMark() error {
+	nft, err := nftables.New()
+	if err != nil {
+		return errors.New("failed to open nftables").Base(err)
+	}
+	if _, err := nft.ListTableOfFamily(replyMarkTable, nftables.TableFamilyINet); err != nil {
+		return nil
+	}
+	nft.DelTable(&nftables.Table{Name: replyMarkTable, Family: nftables.TableFamilyINet})
+	if err := nft.Flush(); err != nil {
+		return errors.New("failed to delete nftables table ", replyMarkTable).Base(err)
+	}
+	return nil
+}
+
+// buildSystemRules mirrors sing-tun's rules for one TUN without uid or
+// interface filters, except its "lookup table suppress_prefixlength 0" rule:
+// it only matters for routes more specific than the default, and netlink
+// v1.3.1 drops suppress_prefixlength for tables numbered 256 and up. Added are
+// the replyMark rule first and the userUIDs rule, see there.
+func buildSystemRules(tunName string, addresses []netip.Prefix, inet4, inet6 bool) []*netlink.Rule {
+	var rules []*netlink.Rule
+	add := func(family, priority int, edit func(*netlink.Rule)) {
+		rule := netlink.NewRule()
+		rule.Family = family
+		rule.Priority = priority
+		edit(rule)
+		rules = append(rules, rule)
+	}
+	var addr4, addr6 []netip.Prefix
+	for _, address := range addresses {
+		if address.Addr().Is4() {
+			addr4 = append(addr4, address.Masked())
+		} else {
+			addr6 = append(addr6, address.Masked())
+		}
+	}
+	replied := func(r *netlink.Rule) { r.Mark = replyMark; r.Table = unix.RT_TABLE_MAIN }
+	if inet4 {
+		const f = unix.AF_INET
+		p := systemRuleStart
+		add(f, p, replied)
+		for _, address := range addr4 {
+			add(f, p, func(r *netlink.Rule) { r.Dst = prefixIPNet(address); r.Table = systemRouteTable })
+		}
+		p++
+		add(f, p, func(r *netlink.Rule) {
+			r.Invert = true
+			r.Dport = netlink.NewRulePortRange(53, 53)
+			r.Table = unix.RT_TABLE_MAIN
+			r.SuppressPrefixlen = 0
+		})
+		add(f, p, func(r *netlink.Rule) { r.IifName = tunName; r.Goto = systemRuleNop })
+		p++
+		add(f, p, func(r *netlink.Rule) { r.Invert = true; r.IifName = "lo"; r.Table = systemRouteTable })
+		add(f, p, func(r *netlink.Rule) {
+			r.IifName = "lo"
+			r.Src = prefixIPNet(netip.PrefixFrom(netip.IPv4Unspecified(), 32))
+			r.Table = systemRouteTable
+		})
+		for _, address := range addr4 {
+			add(f, p, func(r *netlink.Rule) { r.IifName = "lo"; r.Src = prefixIPNet(address); r.Table = systemRouteTable })
+		}
+		add(f, p, func(r *netlink.Rule) { r.IifName = "lo"; r.UIDRange = userUIDs(); r.Table = systemRouteTable })
+		add(f, systemRuleNop, func(r *netlink.Rule) { r.Type = unix.FR_ACT_NOP })
+	}
+	if inet6 {
+		const f = unix.AF_INET6
+		p := systemRuleStart
+		add(f, p, replied)
+		add(f, p, func(r *netlink.Rule) {
+			r.Invert = true
+			r.Dport = netlink.NewRulePortRange(53, 53)
+			r.Table = unix.RT_TABLE_MAIN
+			r.SuppressPrefixlen = 0
+		})
+		p++
+		for _, address := range addr6 {
+			add(f, p, func(r *netlink.Rule) { r.IifName = "lo"; r.Src = prefixIPNet(address); r.Table = systemRouteTable })
+		}
+		p++
+		// IPv6 rules with a source never match a lookup that has none yet, so
+		// unbound sockets pass these and reach the table below
+		add(f, p, func(r *netlink.Rule) { r.IifName = tunName; r.Goto = systemRuleNop })
+		add(f, p, func(r *netlink.Rule) { r.IifName = "lo"; r.UIDRange = userUIDs(); r.Table = systemRouteTable })
+		add(f, p, func(r *netlink.Rule) {
+			r.IifName = "lo"
+			r.Src = prefixIPNet(netip.MustParsePrefix("::/1"))
+			r.Goto = systemRuleNop
+		})
+		add(f, p, func(r *netlink.Rule) {
+			r.IifName = "lo"
+			r.Src = prefixIPNet(netip.MustParsePrefix("8000::/1"))
+			r.Goto = systemRuleNop
+		})
+		p++
+		add(f, p, func(r *netlink.Rule) { r.Table = systemRouteTable })
+		add(f, systemRuleNop, func(r *netlink.Rule) { r.Type = unix.FR_ACT_NOP })
+	}
+	return rules
+}
+
+// deleteSystemRules removes every rule in our priority range, a crashed run's
+// included, the way sing-tun's unsetRules does
+func deleteSystemRules() error {
+	list, err := netlink.RuleList(netlink.FAMILY_ALL)
+	if err != nil {
+		return errors.New("failed to list rules").Base(err)
+	}
+	var errs []error
+	for _, rule := range list {
+		if rule.Priority < systemRuleStart || rule.Priority > systemRuleNop {
+			continue
+		}
+		del := netlink.NewRule()
+		del.Family = rule.Family
+		del.Priority = rule.Priority
+		if err := netlink.RuleDel(del); err != nil {
+			errs = append(errs, errors.New("failed to delete rule ", rule.Priority).Base(err))
+		}
+	}
+	return errors.Combine(errs...)
+}
+
