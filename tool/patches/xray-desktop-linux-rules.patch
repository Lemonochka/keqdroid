+	}
+	t.systemRules = true
+	for _, rule := range buildSystemRules(attrs.Name, addresses, inet4, inet6) {
+		if err := netlink.RuleAdd(rule); err != nil {
+			_ = t.unsetSystemRoutes()
+			return errors.New("failed to add system rule ", rule.Priority).Base(err)
+		}
 	}
 	return nil
 }
 
