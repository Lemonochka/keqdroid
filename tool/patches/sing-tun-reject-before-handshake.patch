diff --git a/tcp_rejecter.go b/tcp_rejecter.go
new file mode 100644
index 0000000..9ba2052
--- /dev/null
+++ b/tcp_rejecter.go
@@ -0,0 +1,24 @@
+package tun
+
+import (
+	"net/netip"
+
+	"github.com/metacubex/sing-tun/internal/gtcpip/header"
+	M "github.com/metacubex/sing/common/metadata"
+)
+
+// TCPRejecter is a handler that may refuse a connection before the handshake.
+// keqdroid, see tool/patches/sing-tun-reject-before-handshake.patch.
+type TCPRejecter interface {
+	RejectTCPBeforeHandshake(source M.Socksaddr, destination M.Socksaddr) bool
+}
+
+// the system stack hands a SYN to a listener of the OS, which answers it at
+// once, so the question comes before the NAT entry, on the first SYN only
+func rejectTCPBeforeHandshake(handler Handler, source, destination netip.AddrPort, tcpHdr header.TCP) bool {
+	if tcpHdr.Flags()&(header.TCPFlagSyn|header.TCPFlagAck) != header.TCPFlagSyn {
+		return false
+	}
+	rejecter, ok := handler.(TCPRejecter)
+	return ok && rejecter.RejectTCPBeforeHandshake(M.SocksaddrFromNetIP(source), M.SocksaddrFromNetIP(destination))
+}
diff --git a/tcp_rejecter_test.go b/tcp_rejecter_test.go
new file mode 100644
index 0000000..6a09121
--- /dev/null
+++ b/tcp_rejecter_test.go
@@ -0,0 +1,73 @@
+package tun
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/metacubex/sing-tun/internal/gtcpip/header"
+	M "github.com/metacubex/sing/common/metadata"
+)
+
+type refusingHandler struct {
+	testHandler
+	asked int
+}
+
+func (h *refusingHandler) RejectTCPBeforeHandshake(_, destination M.Socksaddr) bool {
+	h.asked++
+	return destination.Addr.Is6()
+}
+
+func segment(flags header.TCPFlags) header.TCP {
+	tcp := header.TCP(make([]byte, header.TCPMinimumSize))
+	tcp.Encode(&header.TCPFields{SrcPort: 50000, DstPort: 443, DataOffset: header.TCPMinimumSize, Flags: flags})
+	return tcp
+}
+
+// keqdroid, sing-tun-reject-before-handshake.patch: the system stack asks on
+// the first SYN only, the rest of a connection it has let through never is
+func TestSystemStackAsksBeforeHandshake(t *testing.T) {
+	src := netip.MustParseAddrPort("[fdfe:dcba:9876::1]:50000")
+	v6 := netip.MustParseAddrPort("[2001:db8::1]:443")
+	v4 := netip.MustParseAddrPort("198.51.100.1:443")
+	h := &refusingHandler{}
+
+	if !rejectTCPBeforeHandshake(h, src, v6, segment(header.TCPFlagSyn)) {
+		t.Fatal("a refused SYN went on")
+	}
+	if rejectTCPBeforeHandshake(h, src, v4, segment(header.TCPFlagSyn)) {
+		t.Fatal("an allowed SYN was refused")
+	}
+	for _, flags := range []header.TCPFlags{header.TCPFlagAck, header.TCPFlagSyn | header.TCPFlagAck, header.TCPFlagAck | header.TCPFlagPsh} {
+		if rejectTCPBeforeHandshake(h, src, v6, segment(flags)) {
+			t.Fatal("refused a segment past the SYN: ", flags)
+		}
+	}
+	if h.asked != 2 {
+		t.Fatal("asked ", h.asked, " times, want 2")
+	}
+	if rejectTCPBeforeHandshake(&testHandler{}, src, v6, segment(header.TCPFlagSyn)) {
+		t.Fatal("a handler without the method refused")
+	}
+}
+
+// keqdroid: the mips stack answers a refused SYN with a reset and never hands
+// the connection on, an allowed one opens as before
+func TestMipsStackResetsRefusedSYN(t *testing.T) {
+	d := newMemoryTun()
+	h := &refusingHandler{}
+	testStack(t, d, &testHandler{}, func(o *StackOptions) { o.Handler = h })
+
+	source, target := netip.MustParseAddr("fd00::1"), netip.MustParseAddr("2001:db8::1")
+	d.in <- tcpPacket(source, target, 100, 0, 2, nil)
+	reply := readPacket(t, d)
+	if flags := reply[40+13]; flags&4 == 0 || flags&2 != 0 {
+		t.Fatalf("expected a reset for a refused SYN: %x", reply)
+	}
+
+	v4source, v4target := netip.MustParseAddr("198.18.0.1"), netip.MustParseAddr("198.51.100.1")
+	d.in <- tcpPacket(v4source, v4target, 100, 0, 2, nil)
+	if synAck := readPacket(t, d); synAck[20+13]&18 != 18 {
+		t.Fatalf("expected SYN ACK for an allowed SYN: %x", synAck)
+	}
+}
