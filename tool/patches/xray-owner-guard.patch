+package tun
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+type testGuard struct {
+	reject func(src net.Destination) bool
+}
+
+func (testGuard) guarded() bool { return true }
+
+func (g testGuard) rejectBeforeHandshake(src, _ net.Destination) bool { return g.reject(src) }
+
+// keqdroid, xray-owner-guard.patch: a SYN of an app outside the VPN gets a
+// reset, and the loop that reads the tun goes on while the app is asked
+func TestOwnerGuardBeforeHandshake(t *testing.T) {
+	conns := make(chan accepted, 2)
+	p, l := newPeer(t, "10.0.0.1:1235", "10.0.0.2:80")
+	release := make(chan struct{})
+	asked := make(chan struct{}, 4)
+	s := &stack{ctx: context.Background(), tun: l, mtu: testMTU, window: tcpWindow, handle: accept(conns), conns: make(map[flow]*tcpConn), sockets: make(map[netip.AddrPort]*udpSocket)}
+	s.udp = newUdpConnectionHandler(s.handle, s.writeUDP, nil)
+	s.guard = testGuard{reject: func(src net.Destination) bool {
+		switch src.Port {
+		case 1235:
+			asked <- struct{}{}
+			<-release
+			return false
+		case 1234:
+			return true
+		}
+		return false
+	}}
+	s.Start()
+	t.Cleanup(func() {
+		s.Close()
+		l.Close()
+	})
+
+	// the app takes its time to answer about this one
+	slow := p.seq
+	p.send(slow, tcpSyn, nil, nil)
+	<-asked
+
+	p.src = netip.MustParseAddrPort("10.0.0.1:1234")
+	p.send(p.seq, tcpSyn, nil, nil)
+	if seg := p.receive(); seg.flags != tcpRst|tcpAck || seg.ack != p.seq+1 {
+		t.Fatal("not a reset: flags ", seg.flags, ", ack ", seg.ack)
+	}
+	p.seq++
+
+	p.src = netip.MustParseAddrPort("10.0.0.1:1236")
+	p.connect(nil)
+	if a := take(t, conns); a.conn.RemoteAddr().String() != "10.0.0.1:1236" {
+		t.Fatal("connection from ", a.conn.RemoteAddr())
+	}
+
+	// the SYN sent again while the app is asked is not asked about twice
+	p.src = netip.MustParseAddrPort("10.0.0.1:1235")
+	p.send(slow, tcpSyn, nil, nil)
+	p.silent(100 * time.Millisecond)
+	select {
+	case <-asked:
+		t.Fatal("asked twice about one SYN")
+	default:
+	}
+	close(release)
+	seg := p.receive()
+	if seg.flags != tcpSyn|tcpAck || seg.ack != slow+1 {
+		t.Fatal("not an answer to the SYN: flags ", seg.flags, ", ack ", seg.ack)
+	}
+	p.seq, p.ack = slow+1, seg.seq+1
+	p.send(p.seq, tcpAck, nil, nil)
+	if a := take(t, conns); a.conn.RemoteAddr().String() != "10.0.0.1:1235" {
+		t.Fatal("connection from ", a.conn.RemoteAddr())
+	}
+}
