+// MatchRuleTag applies only the rule tagged tag. keqdroid: the tun asks it
+// before a TCP handshake, see tool/patches/xray-owner-guard.patch.
+func (r *Router) MatchRuleTag(ctx routing.Context, tag string) bool {
+	for _, rule := range *r.rules.Load() {
+		if rule.RuleTag == tag {
+			return rule.Apply(ctx)
+		}
+	}
+	return false
+}
+
+// HasRuleTag reports whether a rule is tagged tag, without applying it
+func (r *Router) HasRuleTag(tag string) bool {
+	for _, rule := range *r.rules.Load() {
+		if rule.RuleTag == tag {
+			return true
+		}
+	}
+	return false
+}
