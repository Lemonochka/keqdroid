diff --git a/listener/sing_tun/close_ipv6.go b/listener/sing_tun/close_ipv6.go
new file mode 100644
index 0000000..ca4d16b
--- /dev/null
+++ b/listener/sing_tun/close_ipv6.go
@@ -0,0 +1,22 @@
+package sing_tun
+
+import (
+	"sync/atomic"
+
+	M "github.com/metacubex/sing/common/metadata"
+)
+
+// keqdroid, see tool/patches/mihomo-v6-tun-reset.patch
+var tunCloseIPv6 atomic.Bool
+
+func SetTunCloseIPv6(enabled bool) {
+	tunCloseIPv6.Store(enabled)
+}
+
+func tunClosesIPv6(destination M.Socksaddr) bool {
+	if !tunCloseIPv6.Load() {
+		return false
+	}
+	addr := destination.Addr
+	return addr.IsValid() && addr.Is6() && !addr.Is4In6()
+}
diff --git a/listener/sing_tun/close_ipv6_test.go b/listener/sing_tun/close_ipv6_test.go
new file mode 100644
index 0000000..1b11570
--- /dev/null
+++ b/listener/sing_tun/close_ipv6_test.go
@@ -0,0 +1,30 @@
+package sing_tun
+
+import (
+	"net/netip"
+	"testing"
+
+	M "github.com/metacubex/sing/common/metadata"
+)
+
+// keqdroid, mihomo-v6-tun-reset.patch: only IPv6 is refused, and only with the key
+func TestTunClosesIPv6(t *testing.T) {
+	v6 := M.SocksaddrFrom(netip.MustParseAddr("2001:db8::1"), 443)
+	v4 := M.SocksaddrFrom(netip.MustParseAddr("198.51.100.1"), 443)
+	mapped := M.SocksaddrFrom(netip.MustParseAddr("::ffff:198.51.100.1"), 443)
+	h := &ListenerHandler{}
+
+	SetTunCloseIPv6(false)
+	if h.RejectTCPBeforeHandshake(M.Socksaddr{}, v6) {
+		t.Fatal("refused IPv6 without keqdroid-tun-close-ipv6")
+	}
+
+	SetTunCloseIPv6(true)
+	t.Cleanup(func() { SetTunCloseIPv6(false) })
+	if !h.RejectTCPBeforeHandshake(M.Socksaddr{}, v6) {
+		t.Fatal("IPv6 not refused with keqdroid-tun-close-ipv6")
+	}
+	if h.RejectTCPBeforeHandshake(M.Socksaddr{}, v4) || h.RejectTCPBeforeHandshake(M.Socksaddr{}, mapped) {
+		t.Fatal("refused IPv4")
+	}
+}
