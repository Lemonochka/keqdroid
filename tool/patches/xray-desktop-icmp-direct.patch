diff --git a/proxy/tun/icmp_direct_test.go b/proxy/tun/icmp_direct_test.go
new file mode 100644
index 0000000..bc95b3b
--- /dev/null
+++ b/proxy/tun/icmp_direct_test.go
@@ -0,0 +1,132 @@
+//go:build windows || (linux && !android)
+
+package tun
+
+import (
+	"encoding/binary"
+	"net/netip"
+	"testing"
+	"time"
+)
+
+var (
+	icmpClient = netip.MustParseAddr("172.19.0.1")
+	icmpTarget = netip.MustParseAddr("1.1.1.1")
+	icmpRouter = netip.MustParseAddr("10.0.0.1")
+)
+
+func echoMessage(typ byte, ident, seq uint16, payload string) []byte {
+	m := make([]byte, 8+len(payload))
+	m[0] = typ
+	binary.BigEndian.PutUint16(m[4:6], ident)
+	binary.BigEndian.PutUint16(m[6:8], seq)
+	copy(m[8:], payload)
+	binary.BigEndian.PutUint16(m[2:4], checksum(sum(m, 0)))
+	return m
+}
+
+func validV4Checksum(m []byte) bool {
+	return checksum(sum(m, 0)) == 0
+}
+
+func newTestDirect() *icmpDirect {
+	d := newICMPDirect(nil)
+	d.pending[icmpPendingKey{dst: icmpTarget, ident: 7, seq: 3}] = icmpPending{
+		src:      icmpClient,
+		ident:    0x1234,
+		checksum: 0xbeef,
+		at:       time.Now(),
+	}
+	return d
+}
+
+func TestICMPDirectEchoReplyGetsClientIdentBack(t *testing.T) {
+	d := newTestDirect()
+	out, src, dst, ok := d.translate(false, echoMessage(icmpv4EchoReply, 7, 3, "abc"), icmpTarget)
+	if !ok {
+		t.Fatal("reply not matched")
+	}
+	if binary.BigEndian.Uint16(out[4:6]) != 0x1234 || binary.BigEndian.Uint16(out[6:8]) != 3 {
+		t.Fatalf("ident/seq %x/%d", out[4:6], out[6:8])
+	}
+	if !validV4Checksum(out) {
+		t.Fatal("bad checksum")
+	}
+	if src != icmpTarget || dst != icmpClient {
+		t.Fatalf("addresses %v -> %v", src, dst)
+	}
+	if len(d.pending) != 0 {
+		t.Fatal("pending kept")
+	}
+	if _, _, _, ok := d.translate(false, echoMessage(icmpv4EchoReply, 7, 3, "abc"), icmpTarget); ok {
+		t.Fatal("second reply matched")
+	}
+}
+
+func TestICMPDirectForeignReplyIgnored(t *testing.T) {
+	d := newTestDirect()
+	if _, _, _, ok := d.translate(false, echoMessage(icmpv4EchoReply, 8, 3, ""), icmpTarget); ok {
+		t.Fatal("foreign ident matched")
+	}
+	if _, _, _, ok := d.translate(false, echoMessage(icmpv4EchoReply, 7, 3, ""), icmpRouter); ok {
+		t.Fatal("foreign address matched")
+	}
+	if len(d.pending) != 1 {
+		t.Fatal("pending lost")
+	}
+}
+
+func TestICMPDirectTimeExceededQuotesTheClient(t *testing.T) {
+	d := newTestDirect()
+	inner := make([]byte, ipv4HeaderSize)
+	putIPHeader(inner, protoICMPv4, netip.MustParseAddr("192.168.1.5"), icmpTarget)
+	inner[8] = 1
+	setIPLength(inner, ipv4HeaderSize+8)
+	quotedEcho := echoMessage(icmpv4Echo, 7, 3, "")
+	message := append([]byte{icmpv4TimeExceeded, 0, 0, 0, 0, 0, 0, 0}, inner...)
+	message = append(message, quotedEcho...)
+	binary.BigEndian.PutUint16(message[2:4], checksum(sum(message, 0)))
+
+	out, src, dst, ok := d.translate(false, message, icmpRouter)
+	if !ok {
+		t.Fatal("error not matched")
+	}
+	if src != icmpRouter || dst != icmpClient {
+		t.Fatalf("addresses %v -> %v", src, dst)
+	}
+	if !validV4Checksum(out) {
+		t.Fatal("bad outer checksum")
+	}
+	ip := out[8 : 8+ipv4HeaderSize]
+	if netip.AddrFrom4([4]byte(ip[12:16])) != icmpClient || checksum(sum(ip, 0)) != 0 {
+		t.Fatalf("quoted source %v, header checksum %x", netip.AddrFrom4([4]byte(ip[12:16])), checksum(sum(ip, 0)))
+	}
+	echo := out[8+ipv4HeaderSize:]
+	if binary.BigEndian.Uint16(echo[4:6]) != 0x1234 || binary.BigEndian.Uint16(echo[2:4]) != 0xbeef {
+		t.Fatalf("quoted echo %x", echo[:8])
+	}
+}
+
+// the v6 reply carries a checksum over the pseudo-header of the TUN addresses
+func TestICMPDirectEchoReplyV6(t *testing.T) {
+	client, target := netip.MustParseAddr("fdfe:dcba:9876::1"), netip.MustParseAddr("2606:4700:4700::1111")
+	d := newICMPDirect(nil)
+	d.pending[icmpPendingKey{dst: target, ident: 9, seq: 1}] = icmpPending{src: client, ident: 0x4321, at: time.Now()}
+	out, src, dst, ok := d.translate(true, echoMessage(icmpv6EchoReply, 9, 1, "xyz"), target)
+	if !ok || src != target || dst != client || binary.BigEndian.Uint16(out[4:6]) != 0x4321 {
+		t.Fatalf("ok %v, %v -> %v, ident %x", ok, src, dst, out[4:6])
+	}
+	var ip [ipv6HeaderSize]byte
+	n := putIPHeader(ip[:], protoICMPv6, src, dst)
+	if checksum(sum(out, pseudoSum(ip[:n], protoICMPv6, len(out)))) != 0 {
+		t.Fatal("bad v6 checksum")
+	}
+}
+
+// a raw socket gets every echo reply of the system, a v4 one is no v6 answer
+func TestICMPDirectWrongFamilyIgnored(t *testing.T) {
+	d := newTestDirect()
+	if _, _, _, ok := d.translate(true, echoMessage(icmpv6EchoReply, 7, 3, ""), icmpTarget); ok {
+		t.Fatal("v4 sender matched a v6 reply")
+	}
+}
diff --git a/proxy/tun/icmp_direct_windows.go b/proxy/tun/icmp_direct_windows.go
new file mode 100644
index 0000000..25adcd9
--- /dev/null
+++ b/proxy/tun/icmp_direct_windows.go
@@ -0,0 +1,21 @@
+//go:build windows
+
+package tun
+
+import (
+	"encoding/binary"
+	stdnet "net"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// IP_UNICAST_IF takes the index in network byte order, IPV6_UNICAST_IF as is
+func bindICMPSocket(fd uintptr, v6 bool, iface *stdnet.Interface) error {
+	if v6 {
+		return windows.SetsockoptInt(windows.Handle(fd), windows.IPPROTO_IPV6, IPV6_UNICAST_IF, iface.Index)
+	}
+	var index [4]byte
+	binary.BigEndian.PutUint32(index[:], uint32(iface.Index))
+	return windows.SetsockoptInt(windows.Handle(fd), windows.IPPROTO_IP, IP_UNICAST_IF, *(*int)(unsafe.Pointer(&index[0])))
+}
