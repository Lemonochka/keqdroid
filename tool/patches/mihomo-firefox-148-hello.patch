--- a/component/tls/utls.go
+++ b/component/tls/utls.go
@@ -28,6 +28,20 @@ func Client(c net.Conn, config *utls.Config) *Conn {
 }
 
 func UClient(c net.Conn, config *utls.Config, fingerprint UClientHelloID) *UConn {
+	// keqdroid: HelloFirefox_148 is ours rather than a profile utls knows about,
+	// so it has to be turned into a spec here - see firefox148.go. Every caller
+	// that builds a uTLS connection goes through this function for that reason.
+	if fingerprint == HelloFirefox_148 {
+		uConn := utls.UClient(c, config, utls.HelloCustom)
+		spec := firefox148Spec()
+		if err := uConn.ApplyPreset(&spec); err != nil {
+			// Falling back to a firefox profile without X25519MLKEM768 would
+			// bring back the exact failure this spec exists to fix, and bring
+			// it back silently. Let the handshake fail loudly instead.
+			log.Errorln("apply Firefox 148 ClientHello: %v", err)
+		}
+		return uConn
+	}
 	return utls.UClient(c, config, fingerprint)
 }
 
