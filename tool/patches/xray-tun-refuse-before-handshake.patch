--- /dev/null
+++ b/proxy/tun/refuse_rule.go
@@ -0,0 +1,33 @@
+package tun
+
+import (
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/routing"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+)
+
+// keqdroid, see tool/patches/xray-tun-refuse-before-handshake.patch: the rule
+// keqdroid writes on the desktop to close IPv6 inside the TUN
+const refusedRuleTag = "tun-ipv6"
+
+type tagRouter interface {
+	HasRuleTag(tag string) bool
+	MatchRuleTag(ctx routing.Context, tag string) bool
+}
+
+// refusedBeforeHandshake reports whether the rule tagged refusedRuleTag takes
+// the connection. The stack asks before it answers the SYN, so the app gets a
+// reset and goes on to its next address, as with a port nobody listens on.
+func (t *Handler) refusedBeforeHandshake(src, dst net.Destination) bool {
+	if t.instance == nil {
+		return false
+	}
+	router, _ := t.instance.GetFeature(routing.RouterType()).(tagRouter)
+	if router == nil || !router.HasRuleTag(refusedRuleTag) {
+		return false
+	}
+	ctx := session.ContextWithInbound(t.ctx, &session.Inbound{Source: src, Tag: t.tag})
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: dst, OriginalTarget: dst}})
+	return router.MatchRuleTag(routing_session.AsRoutingContext(ctx), refusedRuleTag)
+}
