+package router_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/golang/mock/gomock"
+	. "github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/geodata"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/routing"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+	"github.com/xtls/xray-core/testing/mocks"
+)
+
+// keqdroid: the tun asks the rule tagged tun-ipv6 before a handshake, see
+// tool/patches/xray-tun-refuse-before-handshake.patch. It takes IPv6 that
+// comes through the tun, NAT64 addresses as well, and nothing else.
+func TestMatchRuleTagTunIPv6(t *testing.T) {
+	config := &Config{
+		Rule: []*RoutingRule{
+			{
+				TargetTag:  &RoutingRule_Tag{Tag: "block"},
+				RuleTag:    "tun-ipv6",
+				InboundTag: []string{"tun-in"},
+				Ip: []*geodata.IPRule{
+					{
+						Value: &geodata.IPRule_Custom{
+							Custom: &geodata.CIDRRule{
+								Cidr: &geodata.CIDR{Ip: make([]byte, 16), Prefix: 0},
+							},
+						},
+					},
+				},
+			},
+		},
+	}
+
+	mockCtl := gomock.NewController(t)
+	defer mockCtl.Finish()
+
+	r := new(Router)
+	common.Must(r.Init(context.TODO(), config, mocks.NewDNSClient(mockCtl), nil, nil))
+
+	routingCtx := func(inbound string, dest net.Destination) routing.Context {
+		ctx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: inbound})
+		ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: dest, OriginalTarget: dest}})
+		return routing_session.AsRoutingContext(ctx)
+	}
+
+	for _, ip := range []string{"2001:db8::1", "64:ff9b::808:808"} {
+		if !r.MatchRuleTag(routingCtx("tun-in", net.TCPDestination(net.ParseAddress(ip), 443)), "tun-ipv6") {
+			t.Error("tun-ipv6 should take ", ip, " from the tun")
+		}
+	}
+	if r.MatchRuleTag(routingCtx("tun-in", net.TCPDestination(net.ParseAddress("198.51.100.1"), 443)), "tun-ipv6") {
+		t.Error("tun-ipv6 must not take IPv4")
+	}
+	if r.MatchRuleTag(routingCtx("socks-in", net.TCPDestination(net.ParseAddress("2001:db8::1"), 443)), "tun-ipv6") {
+		t.Error("tun-ipv6 must not take what comes through another inbound")
+	}
+}
