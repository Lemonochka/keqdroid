+package tun
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+type testRefuser func(src, dst net.Destination) bool
+
+func (r testRefuser) refusedBeforeHandshake(src, dst net.Destination) bool { return r(src, dst) }
+
+// keqdroid, xray-tun-refuse-before-handshake.patch: a SYN that the config
+// closes gets a reset and no connection, others open as before
+func TestRefusedBeforeHandshake(t *testing.T) {
+	conns := make(chan accepted, 2)
+	p, l := newPeer(t, "[fdfe:dcba:9876::1]:50000", "[2001:db8::1]:443")
+	s := &stack{ctx: context.Background(), tun: l, mtu: testMTU, window: tcpWindow, handle: accept(conns), conns: make(map[flow]*tcpConn), sockets: make(map[netip.AddrPort]*udpSocket)}
+	s.udp = newUdpConnectionHandler(s.handle, s.writeUDP, nil)
+	s.refuser = testRefuser(func(_, dst net.Destination) bool { return dst.Address.Family().IsIPv6() })
+	s.Start()
+	t.Cleanup(func() {
+		s.Close()
+		l.Close()
+	})
+
+	p.send(p.seq, tcpSyn, nil, nil)
+	if seg := p.receive(); seg.flags != tcpRst|tcpAck || seg.ack != p.seq+1 {
+		t.Fatal("not a reset: flags ", seg.flags, ", ack ", seg.ack)
+	}
+	select {
+	case a := <-conns:
+		t.Fatal("a refused connection was handed on, from ", a.conn.RemoteAddr())
+	case <-time.After(100 * time.Millisecond):
+	}
+
+	p.src, p.dst = netip.MustParseAddrPort("172.19.0.1:50001"), netip.MustParseAddrPort("198.51.100.1:443")
+	p.seq = 2000
+	p.connect(nil)
+	if a := take(t, conns); a.conn.RemoteAddr().String() != "172.19.0.1:50001" {
+		t.Fatal("connection from ", a.conn.RemoteAddr())
+	}
+}
