+func globalIDTestContext(inbound string, source net.Destination) context.Context {
+	ctx := context.WithValue(context.Background(), "cone", true)
+	return session.ContextWithInbound(ctx, &session.Inbound{Name: inbound, Source: source})
+}
+
+func checkGlobalIDFrame(t *testing.T, id [8]byte) {
+	t.Helper()
+	destination := net.UDPDestination(net.IPAddress(net.ParseIP("1.2.3.4")), 50001)
+	output := &buf.MultiBufferContainer{}
+	writer := NewPacketWriter(output, destination, id)
+	packet := buf.New()
+	packet.WriteString("voice")
+	packet.UDP = &destination
+	if err := writer.WriteMultiBuffer(buf.MultiBuffer{packet}); err != nil {
+		t.Fatal(err)
+	}
+	if len(output.MultiBuffer) != 1 {
+		t.Fatalf("frames = %d, want 1", len(output.MultiBuffer))
+	}
+	frame := output.MultiBuffer[0]
+	if got := binary.BigEndian.Uint16(frame.Bytes()); got != 20 {
+		t.Fatalf("metadata length = %d, want 20", got)
+	}
+	if frame.Byte(4) != 1 || frame.Byte(5) != 1 || frame.Byte(6) != 2 {
+		t.Fatalf("not an XUDP new-data frame: %v", frame.Bytes())
+	}
+	if !bytes.Equal(frame.Bytes()[14:22], id[:]) {
+		t.Fatalf("frame GlobalID = %v, want %v", frame.Bytes()[14:22], id)
+	}
+}
+
+func TestGlobalIDWithoutScopeMatchesLegacy(t *testing.T) {
+	source := net.UDPDestination(net.IPAddress(net.ParseIP("172.19.0.1")), 50000)
+	for _, inbound := range []string{"tun", "socks"} {
+		t.Run(inbound, func(t *testing.T) {
+			got := GetGlobalID(globalIDTestContext(inbound, source))
+			h := blake3.New(8, ensureBaseKey())
+			h.Write([]byte(source.String()))
+			var want [8]byte
+			copy(want[:], h.Sum(nil))
+			if got == ([8]byte{}) || got != want {
+				t.Fatalf("GlobalID = %v, want legacy %v", got, want)
+			}
+			checkGlobalIDFrame(t, got)
+		})
+	}
+}
+
+func TestGlobalIDScopeSeparatesUDPExits(t *testing.T) {
+	source := net.UDPDestination(net.IPAddress(net.ParseIP("172.19.0.1")), 50000)
+	ctx := globalIDTestContext("tun", source)
+	legacy := GetGlobalID(ctx)
+	seen := make(map[[8]byte]string)
+	for _, scope := range []string{"exit-a", "exit-b", ""} {
+		t.Run(scope, func(t *testing.T) {
+			scopedCtx := ContextWithGlobalIDScope(ctx, scope)
+			id := GetGlobalID(scopedCtx)
+			if id == ([8]byte{}) || id == legacy {
+				t.Fatalf("scoped GlobalID = %v, legacy %v", id, legacy)
+			}
+			if repeated := GetGlobalID(scopedCtx); repeated != id {
+				t.Fatalf("same scope changed GlobalID: %v then %v", id, repeated)
+			}
+			if previous, found := seen[id]; found {
+				t.Fatalf("scopes %q and %q share GlobalID %v", previous, scope, id)
+			}
+			seen[id] = scope
+			checkGlobalIDFrame(t, id)
+		})
+	}
+}

