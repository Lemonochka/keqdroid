+type globalIDPolicyManager struct{}
+
+func (globalIDPolicyManager) Type() interface{}        { return policy.ManagerType() }
+func (globalIDPolicyManager) Start() error             { return nil }
+func (globalIDPolicyManager) Close() error             { return nil }
+func (globalIDPolicyManager) ForSystem() policy.System { return policy.System{} }
+func (globalIDPolicyManager) ForLevel(uint32) policy.Session {
+	return policy.Session{Timeouts: policy.Timeout{ConnectionIdle: time.Minute}}
+}
+
+type globalIDDispatcher struct {
+	called bool
+	id     [8]byte
+}
+
+func (*globalIDDispatcher) Type() interface{} { return routing.DispatcherType() }
+func (*globalIDDispatcher) Start() error      { return nil }
+func (*globalIDDispatcher) Close() error      { return nil }
+func (*globalIDDispatcher) Dispatch(context.Context, xnet.Destination) (*transport.Link, error) {
+	return nil, nil
+}
+func (d *globalIDDispatcher) DispatchLink(ctx context.Context, _ xnet.Destination, _ *transport.Link) error {
+	d.called = true
+	d.id = xudp.GetGlobalID(ctx)
+	return nil
+}
+
+func globalIDForUDPFlow(t *testing.T, perExit bool, exit string) [8]byte {
+	t.Helper()
+	source := xnet.UDPDestination(xnet.ParseAddress("10.0.0.2"), 40000)
+	destination := xnet.UDPDestination(xnet.ParseAddress("1.1.1.1"), 3478)
+	var exitOf func(src xnet.Destination, dst xnet.Destination) string
+	if perExit {
+		exitOf = func(xnet.Destination, xnet.Destination) string { return exit }
+	} else {
+		exit = ""
+	}
+	udpHandler := &udpConnectionHandler{exitOf: exitOf}
+	conn := &udpConn{
+		handler: udpHandler,
+		queue:   newPacketQueue(1),
+		key:     udpKey{src: source, exit: exit},
+		src:     source,
+		dst:     destination,
+	}
+	dispatcher := &globalIDDispatcher{}
+	handler := &Handler{
+		ctx:           context.WithValue(context.Background(), "cone", true),
+		config:        &Config{},
+		policyManager: globalIDPolicyManager{},
+		dispatcher:    dispatcher,
+	}
+	handler.HandleConnection(conn, destination)
+	if !dispatcher.called {
+		t.Fatal("dispatcher was not called")
+	}
+	return dispatcher.id
+}
+
+func TestHandlerScopesGlobalIDOnlyForPerExitFlows(t *testing.T) {
+	legacy := globalIDForUDPFlow(t, false, "")
+	first := globalIDForUDPFlow(t, true, "exit-a")
+	if first == ([8]byte{}) || first == legacy {
+		t.Fatalf("per-exit GlobalID = %v, legacy %v", first, legacy)
+	}
+	if repeated := globalIDForUDPFlow(t, true, "exit-a"); repeated != first {
+		t.Fatalf("same exit changed GlobalID: %v then %v", first, repeated)
+	}
+	if second := globalIDForUDPFlow(t, true, "exit-b"); second == first || second == legacy {
+		t.Fatalf("different exits share GlobalID: %v and %v", first, second)
+	}
+	if empty := globalIDForUDPFlow(t, true, ""); empty == first || empty == legacy {
+		t.Fatalf("empty exit is not distinct: %v, first %v, legacy %v", empty, first, legacy)
+	}
+}
