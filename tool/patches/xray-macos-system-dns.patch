diff --git a/proxy/tun/tun_darwin_dns_test.go b/proxy/tun/tun_darwin_dns_test.go
new file mode 100644
index 0000000..cb3da3e
--- /dev/null
+++ b/proxy/tun/tun_darwin_dns_test.go
@@ -0,0 +1,51 @@
+//go:build darwin && !ios
+
+package tun
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"testing"
+
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+func TestParseDarwinDNSServers(t *testing.T) {
+	got, err := parseDarwinDNSServers(nil)
+	if err != nil || len(got) != 0 {
+		t.Fatalf("empty input gave %v, %v", got, err)
+	}
+
+	got, err = parseDarwinDNSServers([]string{" 172.19.0.1 ", "", "::ffff:172.19.0.2"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0] != netip.MustParseAddr("172.19.0.1") || got[1] != netip.MustParseAddr("172.19.0.2") {
+		t.Fatalf("unexpected parsed servers: %v", got)
+	}
+
+	if _, err := parseDarwinDNSServers([]string{"not-an-ip"}); err == nil {
+		t.Fatal("expected error for invalid IP")
+	}
+}
+
+func TestResolveDarwinOnOwnSkipsTunDNSAndRestores(t *testing.T) {
+	preferGo, dial := net.DefaultResolver.PreferGo, net.DefaultResolver.Dial
+	internet.SkipDNSServers([]netip.Addr{netip.MustParseAddr("172.19.0.1")})
+	t.Cleanup(func() { internet.SkipDNSServers(nil) })
+
+	saved := resolveDarwinOnOwn()
+	if !net.DefaultResolver.PreferGo || net.DefaultResolver.Dial == nil {
+		saved.restore()
+		t.Fatal("net.DefaultResolver was not updated")
+	}
+	if _, err := net.DefaultResolver.Dial(context.Background(), "udp", "172.19.0.1:53"); err == nil {
+		saved.restore()
+		t.Fatal("expected TUN DNS address to be skipped")
+	}
+	saved.restore()
+	if net.DefaultResolver.PreferGo != preferGo || (net.DefaultResolver.Dial == nil) != (dial == nil) {
+		t.Fatal("net.DefaultResolver was not restored")
+	}
+}
