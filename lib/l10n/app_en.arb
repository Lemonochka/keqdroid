  "settingsTunStrictRouteTitle": "Strict route",
  "settingsTunStrictRouteHint": "Prevents traffic from leaking around the TUN. On Windows it can break routing when another VPN (e.g. Tailscale) is active",
  "settingsTunStrictRouteAuto": "Auto",
  "settingsTunStrictRouteAutoHint": "Linux: on, Windows: off",
  "settingsTunStrictRouteOn": "Enabled",
