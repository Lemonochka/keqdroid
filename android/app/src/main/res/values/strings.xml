<?xml version="1.0" encoding="utf-8"?>
<!-- Only launcher-shortcut labels and Quick Settings tile texts live here: the
     app label stays hardcoded in AndroidManifest.xml, and every other
     user-facing string comes from Flutter l10n (lib/l10n). Static shortcuts and
     the tile run without a Flutter engine, so they cannot reuse the Dart
     translations. -->
<resources>
    <string name="shortcut_connect_short">Connect</string>
    <string name="shortcut_connect_long">Connect to VPN</string>
    <string name="shortcut_disconnect_short">Disconnect</string>
    <string name="shortcut_disconnect_long">Disconnect VPN</string>
    <string name="tile_connecting">Connecting…</string>
    <string name="tile_error_start">Couldn\'t start the VPN from Quick Settings — open Keqdis</string>
    <string name="tile_error_open_app">Couldn\'t open Keqdis — launch it manually to connect</string>
    <string name="tile_error_autostart">The system blocked the start. Allow autostart / background activity for Keqdis in the system settings.</string>
</resources>
