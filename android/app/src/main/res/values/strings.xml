<?xml version="1.0" encoding="utf-8"?>
<!-- Only launcher-shortcut labels, Quick Settings tile and home screen widget
     texts live here: the app label stays hardcoded in AndroidManifest.xml, and
     every other user-facing string comes from Flutter l10n (lib/l10n). Static
     shortcuts, the tile and the widget run without a Flutter engine, so they
     cannot reuse the Dart translations. -->
