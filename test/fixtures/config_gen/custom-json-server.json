{
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "freedom",
      "settings": {}
    },
    {
      "protocol": "blackhole",
      "tag": "keq-block"
    },
    {
      "protocol": "dns",
      "tag": "keq-dns-out",
      "settings": {
        "nonIPQuery": "reject"
      }
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "port": 2080,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "auth": "password",
        "udp": true,
        "accounts": [
          {
            "user": "u",
            "pass": "p"
          }
        ]
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "http-in",
      "port": 2081,
      "listen": "127.0.0.1",
      "protocol": "http",
      "settings": {
        "allowTransparent": false,
        "accounts": [
          {
            "user": "u",
            "pass": "p"
          }
        ]
      }
    }
  ],
  "dns": {
    "servers": [
      {
        "address": "localhost",
        "domains": [
          "domain:direct.example"
        ],
        "skipFallback": true,
        "timeoutMs": 2500,
        "serveStale": true
      },
      {
        "address": "https://1.1.1.1/dns-query",
        "timeoutMs": 2500,
        "serveStale": true
      },
      {
        "address": "https://8.8.8.8/dns-query",
        "timeoutMs": 2500,
        "serveStale": true
      },
      {
        "address": "localhost",
        "timeoutMs": 2500,
        "serveStale": true
      }
    ],
    "queryStrategy": "UseIPv4"
  },
  "routing": {
    "rules": [
      {
        "type": "field",
        "ruleTag": "dns-out",
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "keq-dns-out"
      },
      {
        "type": "field",
        "ruleTag": "user-block-domains",
        "domain": [
          "domain:ads.example",
          "geosite:category-ads-all"
        ],
        "outboundTag": "keq-block"
      },
      {
        "type": "field",
        "ruleTag": "user-direct-domains",
        "domain": [
          "domain:direct.example"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ruleTag": "user-direct-ips",
        "ip": [
          "10.10.0.0/16"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ruleTag": "user-proxy-domains",
        "domain": [
          "domain:proxy.example",
          "geosite:google"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ruleTag": "final",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  }
}