{
  "mode": "rule",
  "proxies": [
    {
      "name": "NL",
      "type": "trojan",
      "server": "198.51.100.23",
      "port": 443,
      "password": "password",
      "sni": "nl.example"
    },
    {
      "name": "keq-srv-0",
      "type": "trojan",
      "server": "198.51.100.34",
      "port": 443,
      "password": "password",
      "udp": true,
      "sni": "de.example",
      "client-fingerprint": "firefox",
      "network": "tcp"
    }
  ],
  "proxy-groups": [
    {
      "name": "Proxy",
      "type": "select",
      "proxies": [
        "NL"
      ]
    }
  ],
  "rules": [
    "AND,((NOT,((IN-TYPE,TUN))),(DOMAIN,www.cloudflare.com)),Proxy",
    "IP-CIDR,198.51.100.23/32,DIRECT,no-resolve",
    "IP-CIDR,198.51.100.34/32,DIRECT,no-resolve",
    "IP-CIDR,198.18.0.0/30,DIRECT,no-resolve",
    "DOMAIN-SUFFIX,author.example,DIRECT",
    "DST-PORT,53,DIRECT",
    "DOMAIN-SUFFIX,ads.example,REJECT",
    "GEOSITE,category-ads-all,REJECT",
    "DOMAIN-SUFFIX,direct.example,DIRECT",
    "IP-CIDR,10.10.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,0.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve",
    "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve",
    "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,192.0.0.0/24,DIRECT,no-resolve",
    "IP-CIDR,198.51.100.0/24,DIRECT,no-resolve",
    "IP-CIDR,203.0.113.0/24,DIRECT,no-resolve",
    "DOMAIN-SUFFIX,route.example,keq-srv-0",
    "GEOIP,de,keq-srv-0,no-resolve",
    "DOMAIN-SUFFIX,proxy.example,Proxy",
    "GEOSITE,google,Proxy",
    "IP-CIDR,10.10.0.0/16,DIRECT",
    "GEOIP,de,keq-srv-0",
    "MATCH,Proxy"
  ],
  "socks-port": 2080,
  "port": 2081,
  "bind-address": "127.0.0.1",
  "allow-lan": false,
  "ipv6": false,
  "authentication": [
    "u:p"
  ],
  "log-level": "warning",
  "sniffer": {
    "enable": true,
    "parse-pure-ip": true,
    "override-destination": true,
    "sniff": {
      "HTTP": {
        "ports": [
          "80",
          "8080-8880"
        ]
      },
      "TLS": {
        "ports": [
          "443",
          "8443"
        ]
      },
      "QUIC": {
        "ports": [
          "443",
          "8443"
        ]
      }
    }
  },
  "geodata-mode": true,
  "geo-auto-update": false,
  "find-process-mode": "off",
  "dns": {
    "enable": true,
    "ipv6": false,
    "enhanced-mode": "normal",
    "default-nameserver": [
      "https://1.1.1.1/dns-query",
      "https://8.8.8.8/dns-query"
    ],
    "proxy-server-nameserver": [
      "https://1.1.1.1/dns-query",
      "https://8.8.8.8/dns-query"
    ],
    "nameserver": [
      "https://1.1.1.1/dns-query",
      "https://8.8.8.8/dns-query"
    ],
    "direct-nameserver": [
      "https://1.1.1.1/dns-query",
      "https://8.8.8.8/dns-query",
      "1.1.1.1",
      "8.8.8.8"
    ],
    "respect-rules": true
  },
  "rule-providers": {},
  "tun": {
    "enable": true,
    "stack": "gvisor",
    "auto-route": false,
    "auto-detect-interface": false,
    "dns-hijack": [
      "any:53"
    ]
  }
}